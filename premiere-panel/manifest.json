{
  "id": "com.akshaj.subtitletool.dev",
  "name": "Subby Dev",
  "version": "1.2.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "manifestVersion": 5,
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "clipboard": "readAndWrite"
  },
  "entrypoints": [
    {
      "id": "main",
      "type": "panel",
      "label": {
        "default": "Subby Dev"
      },
      "minimumSize": {
        "width": 280,
        "height": 300
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 600
      },
      "preferredFloatingSize": {
        "width": 420,
        "height": 640
      }
    }
  ]
}
